		{
			"name": "Customer CRM",
			"item": [
				{
					"name": "1. Create Customer (Admin / Sales)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"ABC Traders\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"abc@example.com\",\n  \"businessName\": \"ABC Traders\",\n  \"gstNumber\": \"24ABCDE1234F1Z5\",\n  \"customerType\": \"WHOLESALE\",\n  \"address\": \"Vadodara, Gujarat\",\n  \"status\": \"LEAD\",\n  \"followUpDate\": \"2026-08-20\",\n  \"notes\": \"Interested in monthly supply\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"] }
					}
				},
				{
					"name": "2. List Customers (Paginated)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/customers?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "customers"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
					}
				},
				{
					"name": "3. Search Customers",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/customers?search=ABC", "host": ["{{baseUrl}}"], "path": ["api", "customers"], "query": [{ "key": "search", "value": "ABC" }] }
					}
				},
				{
					"name": "4. Filter Customers (Status & Type)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/customers?status=ACTIVE&customerType=WHOLESALE", "host": ["{{baseUrl}}"], "path": ["api", "customers"], "query": [{ "key": "status", "value": "ACTIVE" }, { "key": "customerType", "value": "WHOLESALE" }] }
					}
				},
				{
					"name": "5. Get Customer Detail",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/customers/1", "host": ["{{baseUrl}}"], "path": ["api", "customers", "1"] }
					}
				},
				{
					"name": "6. Update Customer (Admin / Sales)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"ACTIVE\",\n  \"notes\": \"Updated: Client verified and active\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/customers/1", "host": ["{{baseUrl}}"], "path": ["api", "customers", "1"] }
					}
				},
				{
					"name": "7. Add Follow-up Note",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"note\": \"Called customer regarding monthly bulk order requirement.\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/customers/1/followups", "host": ["{{baseUrl}}"], "path": ["api", "customers", "1", "followups"] }
					}
				},
				{
					"name": "8. Get Follow-up History",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/customers/1/followups", "host": ["{{baseUrl}}"], "path": ["api", "customers", "1", "followups"] }
					}
				}
			]
