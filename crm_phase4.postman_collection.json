{
	"info": {
		"_postman_id": "b8c7d6e5-f4a3-2b1c-0d9e-8f7a6b5c4d3e",
		"name": "Mini ERP CRM - Phase 4 Product & Inventory Module",
		"description": "Postman collection for Phase 4 Product Catalog and Inventory Management backend APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login - Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password@123\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
					}
				},
				{
					"name": "Login - Warehouse",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set('warehouseToken', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"email\": \"warehouse@example.com\",\n  \"password\": \"Password@123\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
					}
				}
			]
		},
		{
			"name": "Product Catalog & Inventory",
			"item": [
				{
					"name": "1. Create Product (Admin / Warehouse)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Industrial Copper Wire 10mm\",\n  \"sku\": \"SKU-COP-001\",\n  \"category\": \"Electrical\",\n  \"unitPrice\": 450.50,\n  \"currentStock\": 100,\n  \"minimumStock\": 20,\n  \"warehouseLocation\": \"Rack A1\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
					}
				},
				{
					"name": "2. List Products (Paginated)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/products?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "products"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
					}
				},
				{
					"name": "3. Search Products",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/products?search=Copper", "host": ["{{baseUrl}}"], "path": ["api", "products"], "query": [{ "key": "search", "value": "Copper" }] }
					}
				},
				{
					"name": "4. Filter Low Stock Products",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/products?lowStock=true", "host": ["{{baseUrl}}"], "path": ["api", "products"], "query": [{ "key": "lowStock", "value": "true" }] }
					}
				},
				{
					"name": "5. Get Product Detail",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] }
					}
				},
				{
					"name": "6. Update Product (Admin / Warehouse)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"warehouseLocation\": \"Rack A1-Updated\",\n  \"unitPrice\": 475.00\n}" },
						"url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] }
					}
				},
				{
					"name": "7. Stock Adjustment - IN (Admin / Warehouse)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"quantity\": 50,\n  \"type\": \"IN\",\n  \"reason\": \"Received new shipment from vendor\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/products/1/movements", "host": ["{{baseUrl}}"], "path": ["api", "products", "1", "movements"] }
					}
				},
				{
					"name": "8. Stock Adjustment - OUT (Admin / Warehouse)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"quantity\": 20,\n  \"type\": \"OUT\",\n  \"reason\": \"Dispatched batch to client\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/products/1/movements", "host": ["{{baseUrl}}"], "path": ["api", "products", "1", "movements"] }
					}
				},
				{
					"name": "9. Get Stock Movement History",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/products/1/movements", "host": ["{{baseUrl}}"], "path": ["api", "products", "1", "movements"] }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
		{ "key": "token", "value": "", "type": "string" }
	]
}
